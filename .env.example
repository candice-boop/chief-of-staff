# Copy this file to .env.local (already gitignored) and fill in a real key
# to enable the experimental "Triage with AI" feature in Inbox.
#
# This key is used directly from the browser (see src/lib/anthropicClient.ts) —
# fine for this local-only, single-user app, but never bake a real key into a
# build that gets deployed or shared.
VITE_ANTHROPIC_API_KEY=
